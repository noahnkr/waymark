{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wm hook claude-code SessionStart",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "wm hook claude-code PreToolUse",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "wm hook claude-code PostToolUse",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "wm-implementer|wm-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "wm hook claude-code SubagentStop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
